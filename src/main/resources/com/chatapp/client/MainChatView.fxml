<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chatapp.client.controller.MainChatController" style="-fx-font-family: 'Segoe UI';">
    <left>
        <VBox spacing="10" prefWidth="200" style="-fx-padding: 10; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 1 0 0;">
            <Label text="Thành Viên Online" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
            <ListView fx:id="listOnlineUsers" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 5;"/>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Nhóm Chat" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                <Button text="+" onAction="#handleCreateGroup" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 2 6;"/>
            </HBox>
            <ListView fx:id="listGroups" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 5;"/>
            
            <Button text="Đăng Xuất" onAction="#handleLogout" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>
    <center>
        <TabPane fx:id="tabPaneChats" tabClosingPolicy="ALL_TABS"/>
    </center>
</BorderPane>
